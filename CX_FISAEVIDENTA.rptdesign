            <property name="dataSource">maximoDataSource</property>
            <method name="open"><![CDATA[DataSet = MXReportDataSetProvider.create(this.getDataSource().getName(), this.getName());
DataSet.open();

var where = '1=1';



if (params["personid"].value) {
    where += " AND " + MXReportSqlFormat.createParamWhereClause(
        "p.PERSONID",
        params["personid"].toUpperCase()
    );
}

if (params["data"].value) {

  //  if (params["istoric"].value == 'N') {

           
     //      where += " AND cxf.cxfromdate <= "
     //         + MXReportSqlFormat.getStartDayTimestampFunction(params["data"]);

     //   where += " AND NOT EXISTS ( "
     //         + "  SELECT 1 "
 ///    + " FROM cxfolosinta ccas "
 //  + "   WHERE ccas.ROTASSETNUM = cxf.ROTASSETNUM "
  //   + "   AND RTRIM(ccas.location) LIKE '%CASARE' and ccas.cxfromdate <= "
    //          + MXReportSqlFormat.getStartDayTimestampFunction(params["data"])
    //          + " )";

    //    where += " AND RTRIM(cxf.location) NOT LIKE '%CASARE'";

   //      where += " AND ( cxf.CXLADATA >"
    //          + MXReportSqlFormat.getStartDayTimestampFunction(params["data"]) +
    //      " OR cxf.CXLADATA IS NULL ) "
        
   // }
   // ponytail: end-of-day — altfel Restituiri din ziua selectată (ex. 12:45) cad după start-of-day 00:00
   if (params["istoric"].value == 'N') {

    where += " AND cxf.cxfromdate <= "
          + MXReportSqlFormat.getEndDayTimestampFunction(params["data"]);

    where += " AND NOT EXISTS ( "
          + " SELECT 1 "
          + " FROM cxfolosinta ccas "
          + " WHERE ccas.ROTASSETNUM = cxf.ROTASSETNUM "
          + "   AND RTRIM(ccas.location) LIKE '%CASARE' "
          + "   AND ccas.cxfromdate <= "
          + MXReportSqlFormat.getEndDayTimestampFunction(params["data"])
          + " ) ";

    where += " AND RTRIM(cxf.location) NOT LIKE '%CASARE' ";

    where += " AND ( "
          + " cxf.CXLADATA > "
          + MXReportSqlFormat.getEndDayTimestampFunction(params["data"])
          + " OR cxf.CXLADATA IS NULL "
          + " ) ";

    where += " AND NOT EXISTS ( "
          + " SELECT 1 "
          + " FROM cxfolosinta cxnext "
          + " WHERE cxnext.ROTASSETNUM = cxf.ROTASSETNUM "
          + "   AND cxnext.CXFROMDATE > cxf.CXFROMDATE "
          + "   AND cxnext.CXFROMDATE <= "
          + MXReportSqlFormat.getEndDayTimestampFunction(params["data"])
          + "   AND cxnext.PERSONID <> cxf.PERSONID "
          + " ) ";

}
   
    else {
        // istoric până la sfârșitul zilei selectate
        where += " AND cxf.cxfromdate <= "
              + MXReportSqlFormat.getEndDayTimestampFunction(params["data"]);
    }
}



var sqlText = new String();

// ponytail: Restituiri = MATRECTRANS când CXREFMBOTO='MATRECTRANS', altfel cxf2 (transfer folosință)
sqlText = "SELECT m.quantity as mqty, m.issueto,m.actualdate, ii.CXBONCONSUM as bon, cxf.PERSONID, p.DISPLAYNAME, cxf.ROTASSETNUM as assetnum, a1.CXNRINVENTAR AS CXNRINVENTAR, cxf.itemnum, i.description, "
+"           cxf.unitcost, i.orderunit as receivedunit, cxf.cxnrdoc as cxbonconsum, cxf.cxfromdate AS cxdatabon, cxf.quantity AS quantity, cxf.location, "
+"           CASE WHEN cxf.CXREFMBOTO = 'MATRECTRANS' THEN m.actualdate ELSE cxf2.cxfromdate END as ladata, "
+"           CASE WHEN cxf.CXREFMBOTO = 'MATRECTRANS' THEN ii.CXBONCONSUM ELSE cxf2.cxnrdoc END as nrdoc, "
+"           CASE WHEN cxf.CXREFMBOTO = 'MATRECTRANS' THEN ABS(m.quantity) ELSE cxf2.quantity END as cantpredat "
+"	FROM cxfolosinta cxf "
+" LEFT JOIN cxfolosinta cxf2 ON cxf.CXREFIDTO = cxf2.CXFOLOSINTAID "
+"   AND (cxf.CXREFMBOTO IS NULL OR cxf.CXREFMBOTO <> 'MATRECTRANS') "
+" 	LEFT JOIN person p "
+"	ON cxf.personid = p.personid "
+"	LEFT JOIN asset a1 ON cxf.rotassetnum = a1.assetnum "
+"	LEFT JOIN item i ON cxf.itemnum = i.itemnum "
+" LEFT JOIN MATRECTRANS m ON m.MATRECTRANSID = cxf.CXREFIDTO AND cxf.CXREFMBOTO ='MATRECTRANS' "
+"	LEFT JOIN INVUSE ii ON ii.invuseid=m.INVUSEID "
+"	WHERE " + where 
+"  AND cxf.location NOT LIKE '%CASARE' and cxf.rotassetnum is not null "
+" ORDER BY cxdatabon, itemnum, cxnrinventar "


;
DataSet.setQuery(sqlText);]]></method>
            <method name="fetch"><![CDATA[if (!DataSet.fetch())
	return (false);

// Add a line for each output column
// The specific get method should match the data type of the output column.



row["mqty"] = DataSet.getDouble("mqty");
row["issueto"] = DataSet.getString("issueto");
row["actualdate"] = DataSet.getDate("actualdate");
row["bon"] = DataSet.getString("bon");


row["description"] = DataSet.getString("description");
row["itemnum"] = DataSet.getString("itemnum");
row["displayname"] = DataSet.getString("displayname");
row["assetnum"] = DataSet.getString("assetnum");
row["cxnrinventar"] = DataSet.getString("cxnrinventar");
row["receivedunit"] = DataSet.getString("receivedunit");
row["unitcost"] = DataSet.getDouble("unitcost");
row["cxbonconsum"] = DataSet.getString("cxbonconsum");
row["quantity"] = DataSet.getDouble("quantity");
row["cxdatabon"] = DataSet.getDate("cxdatabon");
row["ladata"] = DataSet.getDate("ladata");
row["nrdoc"] = DataSet.getString("nrdoc");
row["cantpredat"] = DataSet.getDouble("cantpredat");





	

return (true);]]></method>
        </script-data-set>
